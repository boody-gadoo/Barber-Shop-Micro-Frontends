{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "booking-angular": {
      "projectType": "application",
      "root": "apps/booking-angular",
      "sourceRoot": "apps/booking-angular/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-builders/custom-webpack:browser",
          "options": {
            "customWebpackConfig": {
              "path": "apps/booking-angular/webpack.config.js"
            },
            "outputPath": "apps/booking-angular/dist",
            "index": "apps/booking-angular/src/index.html",
            "main": "apps/booking-angular/src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "apps/booking-angular/tsconfig.app.json",
            "assets": [
              "apps/booking-angular/src/favicon.ico",
              "apps/booking-angular/src/assets",
              {
                "glob": "**/*",
                "input": "public",
                "output": "/"
              }
            ],
            "styles": [
              "apps/booking-angular/src/styles.css"
            ],
            "scripts": [],
            "vendorChunk": true,
            "extractLicenses": false,
            "sourceMap": true,
            "namedChunks": true,
            "aot": true,
            "outputHashing": "none"
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kb",
                  "maximumError": "1mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2kb",
                  "maximumError": "4kb"
                }
              ],
              "outputHashing": "none"
            },
            "development": {
              "buildOptimizer": false,
              "optimization": false,
              "vendorChunk": true,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-builders/custom-webpack:dev-server",
          "options": {
            "port": 3003,
          },
          "configurations": {
            "production": {
              "buildTarget": "booking-angular:build:production"
            },
            "development": {
              "buildTarget": "booking-angular:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "buildTarget": "booking-angular:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "apps/booking-angular/tsconfig.spec.json",
            "inlineStyleLanguage": "css",
            "assets": [
              "apps/booking-angular/src/favicon.ico",
              "apps/booking-angular/src/assets",
              {
                "glob": "**/*",
                "input": "public",
                "output": "/"
              }
            ],
            "styles": [
              "apps/booking-angular/src/styles.css"
            ],
            "scripts": []
          }
        }
      }
    }
  }
}
